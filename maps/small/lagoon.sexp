  (day-limit 20)
  (funds 20000 20000)
  (build inf mech recon tank md neo art rkt aa msl apc fighter bomber bcopter tcopter bship cruiser lander sub)
  (tiles
    ".^c^c..w......"
    ".hc=.w....w^.."
